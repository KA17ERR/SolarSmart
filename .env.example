# Optional server-side upstream for the Next.js server route. Leave empty for local deterministic answers.
# For local SAM: http://127.0.0.1:3001/explain. Never prefix this with NEXT_PUBLIC_.
SOLARSMART_AI_ENDPOINT=
# Optional direct server-only key for local SAM or non-Amplify hosting. Never set NEXT_PUBLIC_*
# or copy this value into .env.production/build artifacts. Amplify should use the SSM variables below.
SOLARSMART_AI_API_KEY=
# Amplify only: name of a Systems Manager Parameter Store SecureString, plus the parameter's region.
# The Amplify SSR Compute role must be allowed to read/decrypt this exact parameter.
SOLARSMART_AI_API_KEY_PARAMETER=
SOLARSMART_AI_SECRET_REGION=
# Strands is configured on the optional SAM Lambda with SAM parameters, not here:
# sam deploy --parameter-overrides "DeploymentEnvironment=dev RequireApiKey=true StrandsEnabled=true StrandsModelId=<model-id>"
# Model inference requires AWS credentials/model access and may incur charges.

# Optional Supabase Auth + Postgres project storage. Keep blank for the complete local demo.
# These are the public project URL and publishable/anon browser-safe key; database RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility with Supabase projects that still label the publishable key "anon".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to create email confirmation and recovery links in non-local deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public browser key for MapTiler Satellite Hybrid tiles only. Restrict by the
# allowed website origins in MapTiler. This is intentionally NEXT_PUBLIC_ because
# the Leaflet tile requests run in the browser.
NEXT_PUBLIC_MAPTILER_API_KEY=
# Separate public browser key for Geoapify India-biased address autocomplete.
# Restrict its API permissions and allowed website referrers/origins in Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Optional public XYZ tile override. Configure matching tile
# attribution when replacing MapTiler; never put a private credential here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Never add SUPABASE_SERVICE_ROLE_KEY or another elevated key to the frontend environment.
